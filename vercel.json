{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "functions": {
    "api/trpc/[trpc].mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/trpc/(.*)", "destination": "/api/trpc/$1" },
    { "source": "/api/webhook", "destination": "/api/webhook" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
